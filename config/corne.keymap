#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <5 17 29 28 16 4 3 15 27 26 14 2 1 13 25 24 12 0 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <36 37 38 39 40 41 30 18 6 7 31 19 8 20 32 9 21 33 10 22 34 11 23 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&HML ESCAPE TAB  &kp Q  &kp W            &kp E             &kp R  &kp T        &kp Y    &kp U  &kp I              &kp O             &kp P     &kp BSPC
&kp LCTRL        &kp A  &HML LEFT_ALT S  &HML LEFT_META D  &kp F  &kp G        &kp H    &kp J  &HMR RIGHT_META K  &HMR RIGHT_ALT L  &kp SEMI  &kp SQT
&kp LSHFT        &kp Z  &kp X            &kp C             &kp V  &kp B        &kp N    &kp M  &kp COMMA          &kp DOT           &kp FSLH  &HMR RIGHT_SHIFT CAPSLOCK
                                         &kp MINUS         &mo 1  &kp SPACE    &kp RET  &mo 2  &kp EQUAL
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&HML ESCAPE TAB   &trans                          &mt AMPERSAND NUMBER_7    &mt ASTERISK NUMBER_8  &mt LEFT_PARENTHESIS NUMBER_9  &trans       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE         &kp BSPC
&kp LEFT_CONTROL  &trans                          &mt DOLLAR NUMBER_4       &mt PERCENT NUMBER_5   &mt CARET NUMBER_6             &trans       &trans            &kp LEFT_ARROW     &kp DOWN_ARROW        &kp UP_ARROW           &kp RIGHT_ARROW  &kp GRAVE
&kp LSHFT         &mt RIGHT_PARENTHESIS NUMBER_0  &mt EXCLAMATION NUMBER_1  &mt AT NUMBER_2        &mt HASH NUMBER_3              &trans       &trans            &trans             &trans                &trans                 &kp BACKSLASH    &trans
                                                                            &trans                 &trans                         &kp SPACE    &kp RET           &trans             &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&HML ESCAPE TAB  &kp C_VOLUME_UP  &kp F7  &kp F8        &kp F9  &kp F12      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4  &kp C_NEXT
&kp LCTRL        &kp C_VOL_DN     &kp F4  &kp F5        &kp F6  &kp F11      &trans        &kp HOME      &kp PAGE_DOWN  &kp PAGE_UP   &kp INSERT    &kp C_PREV
&kp LSHFT        &kp K_MUTE       &kp F1  &kp F2        &kp F3  &kp F10      &bt BT_CLR    &trans        &trans         &trans        &trans        &kp C_PLAY_PAUSE
                                          &kp LEFT_ALT  &trans  &kp SPACE    &kp RET       &trans        &trans
            >;
        };
    };
};
