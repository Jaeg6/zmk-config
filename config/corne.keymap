#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <5 17 29 28 16 4 3 15 27 26 14 2 1 13 25 24 12 0 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <36 37 38 39 40 41 30 18 6 7 31 19 8 20 32 9 21 33 10 22 34 11 23 35>;
        };
    };

    combos {
        compatible = "zmk,combos";

        rbracecombo {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <19 18>;
        };

        lbracecombo {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 17>;
        };

        rparencombo {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 19>;
        };

        lparancombo {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 16>;
        };

        rbracketcombo {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <31 19>;
        };

        lbracketcombo {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <28 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&HML ESCAPE TAB   &kp Q  &kp W            &kp E             &kp R  &kp T        &kp Y    &kp U  &kp I              &kp O             &kp P     &kp BSPC
&kp LEFT_SHIFT    &kp A  &HML LEFT_ALT S  &HML LEFT_META D  &kp F  &kp G        &kp H    &kp J  &HMR RIGHT_META K  &HMR RIGHT_ALT L  &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z  &kp X            &kp C             &kp V  &kp B        &kp N    &kp M  &kp COMMA          &kp DOT           &kp FSLH  &HMR RIGHT_CONTROL CAPSLOCK
                                          &kp MINUS         &mo 1  &kp SPACE    &kp RET  &mo 2  &kp EQUAL
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans                           &HML AMPERSAND NUMBER_7    &HML ASTERISK NUMBER_8  &HML LEFT_PARENTHESIS NUMBER_9  &trans       &trans   &kp ASTERISK     &kp UP_ARROW    &kp DELETE       &trans         &kp BSPC
&trans  &trans                           &HML DOLLAR NUMBER_4       &HML PERCENT NUMBER_5   &HML CARET NUMBER_6             &trans       &trans   &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans         &kp GRAVE
&trans  &HML RIGHT_PARENTHESIS NUMBER_0  &HML EXCLAMATION NUMBER_1  &HML AT NUMBER_2        &HML HASH NUMBER_3              &trans       &trans   &kp EXCLAMATION  &kp PIPE        &kp AMPERSAND    &kp BACKSLASH  &trans
                                                                    &trans                  &trans                          &kp SPACE    &kp RET  &trans           &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp C_VOLUME_UP    &trans  &kp F7  &kp F8        &kp F9  &kp F12      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4  &kp C_NEXT
&kp C_VOLUME_DOWN  &trans  &kp F4  &kp F5        &kp F6  &kp F11      &trans        &kp HOME      &kp PAGE_DOWN  &kp PAGE_UP   &kp INSERT    &kp C_PREV
&kp K_MUTE         &trans  &kp F1  &kp F2        &kp F3  &kp F10      &bt BT_CLR    &trans        &trans         &trans        &trans        &kp C_PLAY_PAUSE
                                   &kp LEFT_ALT  &trans  &kp SPACE    &kp RET       &trans        &trans
            >;
        };
    };
};
